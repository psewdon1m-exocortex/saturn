{
  "name": "saturn-gateway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "concurrently -n api,worker,web -c cyan,magenta,green \"pnpm --filter @saturn/api dev\" \"pnpm --filter @saturn/worker dev\" \"pnpm --filter @saturn/web dev\"",
    "dev:prepare": "node scripts/prepare-dev.mjs",
    "dev:up": "node scripts/dev-up.mjs",
    "dev:down": "docker compose -p vault-dev down --remove-orphans",
    "db:migrate": "pnpm --filter @saturn/database migrate",
    "db:rollback": "pnpm --filter @saturn/database rollback",
    "storage:layout:up": "pnpm --filter @saturn/storage migrate:layout -- up",
    "storage:layout:down": "pnpm --filter @saturn/storage migrate:layout -- down",
    "verify:stage:0": "node scripts/verify-stage-00.mjs",
    "verify:stage:2": "node scripts/verify-stage-02.mjs",
    "verify:stage:3": "node scripts/verify-stage-03.mjs",
    "verify:stage:3:live": "node scripts/verify-stage-03-live.mjs",
    "verify:stage:4": "node scripts/verify-stage-04.mjs",
    "verify:stage:4:live": "node scripts/verify-stage-04-live.mjs",
    "verify:stage:5": "node scripts/verify-stage-05.mjs",
    "verify:stage:6": "node scripts/verify-stage-06.mjs",
    "verify:stage:7": "node scripts/verify-stage-07.mjs",
    "verify:stage:8": "node scripts/verify-stage-08.mjs",
    "verify:stage:9": "node scripts/verify-stage-09.mjs",
    "verify:stage:10": "node scripts/verify-stage-10.mjs",
    "verify:stage:12": "node scripts/verify-stage-12.mjs",
    "verify:stage:13": "node scripts/verify-stage-13.mjs",
    "verify:stage:15": "node scripts/prepare-dev.mjs && node --env-file=.tmp/dev-runtime.env node_modules/tsx/dist/cli.mjs --tsconfig apps/api/tsconfig.json scripts/verify-stage-15.mts",
    "prod:validate": "node scripts/validate-production.mjs",
    "prod:bootstrap-storage": "node scripts/storage-bootstrap.mjs",
    "prod:smoke-storage": "node scripts/storage-smoke.mjs",
    "prod:release": "node scripts/release-bundle.mjs",
    "recovery": "node scripts/recovery-cli.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "archiver": "7.0.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "pnpm": "11.24.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
