diff --git a/src/index.js b/src/index.js
--- a/src/index.js
+++ b/src/index.js
@@ -423,7 +423,13 @@
     c.reserved = null
     c.onclose && (c.onclose(e), c.onclose = null)
     options.onclose && options.onclose(c.id)
-    queries.length && connect(c, queries.shift())
+    if (queries.length) {
+      const query = queries.shift()
+      // A reservation is completed by onopen, unlike an executable query.
+      // Keep it queued while the replacement connection is established.
+      query.reserve && queries.push(query)
+      connect(c, query)
+    }
   }
 }
 
