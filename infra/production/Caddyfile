{
  admin off
  email {$ACME_EMAIL}
  http_port 8080
  https_port 8443
  servers {
    strict_sni_host on
    protocols h1 h2
    timeouts {
      read_body 2m
      read_header 10s
      idle 2m
    }
    max_header_size 32KB
  }
}

# Unknown HTTP virtual hosts have no discovery response or product header.
http://:8080 {
  header -Server
  header X-Robots-Tag "noindex, nofollow, noarchive"
  respond 404
}

{$VAULT_DOMAIN} {
  route {
  encode zstd gzip

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    X-Robots-Tag "noindex, nofollow, noarchive"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; frame-src 'self' blob:"
  }

  @blocked path /.git* /.env* /.secrets* /artifacts* /data* /spool* /docs* /*.map
  respond @blocked 404

  # Operator and internal API surfaces are private. Public capabilities retain their own authentication.
  @outsidePrivate {
    not remote_ip {$VAULT_PRIVATE_CLIENT_CIDRS:127.0.0.1/32 ::1/128}
    not path /s/* /drop /a/* /assets/* /robots.txt /api/v1/public/shares/* /api/v1/drop/redeem /api/v1/drop/session /api/v1/drop/uploads /api/v1/drop/uploads/* /api/v1/drop/complete /api/v1/drop/logout /dav /dav/* /api/v1/backups/* /api/v1/neptune/agent/* /api/v1/backup-enrollments/redeem /api/v1/sync/preferences
  }
  respond @outsidePrivate 404

  handle /api/* {
    reverse_proxy api:3000
  }
  handle /internal/gryphon/command {
    reverse_proxy api:3000
  }
  handle /a/* {
    reverse_proxy api:3000
  }
  handle /dav* {
    reverse_proxy api:3000
  }
  handle /health/live {
    reverse_proxy api:3000
  }
  handle /health/ready {
    reverse_proxy api:3000
  }
  handle /assets/* {
    root * /srv
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle /robots.txt {
    root * /srv
    header Cache-Control "public, max-age=3600"
    file_server
  }
  @spa path / /files /files/* /inbox /inbox/* /shared /trash /settings /synchronization /drop /s/*
  handle @spa {
    root * /srv
    rewrite * /index.html
    header Cache-Control "private, no-store"
    file_server
  }
  respond 404
  }
}
