# Install this file as /etc/nginx/sites-available/saturn.conf and replace the
# domain/certificate paths before enabling it. The owner login and authenticated
# application are public by IP; Saturn itself still binds only to loopback.

upstream saturn_web {
    server 127.0.0.1:8080;
    keepalive 16;
}

upstream saturn_api {
    server 127.0.0.1:3000;
    keepalive 32;
}

# Fail closed for any Host/SNI that is not explicitly configured below.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name drive.replace-me.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name drive.replace-me.example;

    ssl_certificate /etc/nginx/tls/saturn.crt;
    ssl_certificate_key /etc/nginx/tls/saturn.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 16m;
    client_body_timeout 120s;
    keepalive_timeout 75s;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; frame-src 'self' blob:" always;

    location ~ ^/(?:\.git|\.env|\.secrets|artifacts|data|docs|spool)(?:/|$) { return 404; }
    location ~ \.map$ { return 404; }

    # Public UI capabilities. Authentication/authorization remains in Saturn.
    location = /drop { proxy_pass http://saturn_web; }
    location ^~ /s/ { proxy_pass http://saturn_web; }
    location ^~ /assets/ { proxy_pass http://saturn_web; }
    location = /robots.txt { proxy_pass http://saturn_web; }

    # Public capability APIs. Keep this list explicit.
    location ^~ /api/v1/public/shares/ { proxy_pass http://saturn_api; proxy_request_buffering off; proxy_buffering off; }
    location = /api/v1/drop/redeem { proxy_pass http://saturn_api; proxy_request_buffering off; }
    location = /api/v1/drop/session { proxy_pass http://saturn_api; proxy_buffering off; }
    location = /api/v1/drop/uploads { proxy_pass http://saturn_api; proxy_request_buffering off; proxy_buffering off; }
    location ^~ /api/v1/drop/uploads/ { proxy_pass http://saturn_api; proxy_request_buffering off; proxy_buffering off; }
    location = /api/v1/drop/events { proxy_pass http://saturn_api; proxy_buffering off; }
    location = /api/v1/drop/complete { proxy_pass http://saturn_api; proxy_request_buffering off; }
    location = /api/v1/drop/logout { proxy_pass http://saturn_api; }
    location ^~ /api/v1/backups/ { proxy_pass http://saturn_api; proxy_request_buffering off; proxy_buffering off; }
    location = /api/v1/backups/capabilities { proxy_pass http://saturn_api; }
    location = /api/v1/backup-enrollments/redeem { proxy_pass http://saturn_api; }
    location ^~ /api/v1/neptune/agent/ { proxy_pass http://saturn_api; proxy_request_buffering off; }
    location = /api/v1/sync/preferences { proxy_pass http://saturn_api; }
    location ^~ /a/ { proxy_pass http://saturn_api; proxy_buffering off; }
    # WebDAV clients upload a whole file in one PUT. Disable only Nginx's body
    # limit here; Saturn remains the authoritative upload-size boundary.
    location = /dav {
        client_max_body_size 0;
        proxy_pass http://saturn_api;
        proxy_request_buffering off;
        proxy_buffering off;
    }
    location ^~ /dav/ {
        client_max_body_size 0;
        proxy_pass http://saturn_api;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    # Public-authenticated owner API. Saturn enforces Access Key, session, CSRF,
    # reauthentication and authorization checks behind this route.
    location /api/ {
        proxy_pass http://saturn_api;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    # Health stays host-local. Public monitoring must use an authenticated
    # application endpoint or a separate explicitly authorized integration.
    location = /health/live {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://saturn_api;
    }
    location = /health/ready {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://saturn_api;
    }
    location / {
        proxy_pass http://saturn_web;
    }
}
