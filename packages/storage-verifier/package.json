{
  "name": "@saturn/storage-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": { "@saturn/contracts": "workspace:*" },
  "devDependencies": { "tsup": "catalog:", "typescript": "catalog:" }
}
