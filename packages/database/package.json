{
  "name": "@saturn/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/migrate.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts up",
    "rollback": "tsx src/migrate.ts down"
  },
  "dependencies": {
    "@saturn/contracts": "workspace:*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "tsx": "4.23.12",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
