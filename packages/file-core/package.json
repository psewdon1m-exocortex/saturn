{
  "name": "@saturn/file-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "pretest": "pnpm --filter @saturn/storage build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@saturn/audit": "workspace:*",
    "@saturn/database": "workspace:*",
    "@saturn/storage": "workspace:*",
    "file-type": "22.0.2",
    "postgres": "3.4.9",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
