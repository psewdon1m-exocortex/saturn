    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
